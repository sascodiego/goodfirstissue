{
  "version": "bench-1",
  "policy_version": "p1-1",
  "purpose": "Measure the wording of the P1 questions against hand-labelled cases before freezing it.",
  "required_coverage": [
    {
      "trap": "bug_with_feature_prefix",
      "min": 1,
      "why": "the inverse disguise"
    },
    {
      "trap": "author_applied_bug_and_urgent_labels",
      "min": 1,
      "why": "labels written by the requester are claims, not facts"
    },
    {
      "trap": "bug_with_nine_linked_prs",
      "min": 1,
      "why": "a recommendation of work already taken is the worst output"
    },
    {
      "trap": "completed_by_native_state_reason",
      "min": 1,
      "why": "native state reason resolves it without a question"
    },
    {
      "trap": "declined_by_native_state_reason",
      "min": 1,
      "why": "native state reason resolves it without a question"
    },
    {
      "trap": "open_work_preempts_doubt",
      "min": 1,
      "why": "a deterministic fact outranks an abstention"
    },
    {
      "trap": "evidence_that_does_not_reach",
      "min": 1,
      "why": "insufficient evidence is doubt, never a discard (I10)"
    },
    {
      "trap": "title_only",
      "min": 1,
      "why": "the same doubt path with no body at all"
    },
    {
      "trap": "bug_without_reproduction",
      "min": 1,
      "why": "a bug without a reproduction cannot be worked"
    },
    {
      "trap": "control_well_formed_bug",
      "min": 1,
      "why": "the control: a well formed bug must not be rejected"
    },
    {
      "trap": "authorized_by_maintainer_prose_against_label",
      "min": 1,
      "why": "authorisation lives in prose, and the label disagreed"
    },
    {
      "trap": "question_disguised_as_feature_request",
      "min": 1,
      "why": "support questions look like feature requests"
    },
    {
      "trap": "new_behaviour_labelled_bug",
      "min": 1,
      "why": "new behaviour labelled as a bug"
    },
    {
      "trap": "terse_but_classifiable",
      "min": 1,
      "why": "short is not the same as insufficient"
    },
    {
      "trap": "bug_without_trace_but_with_steps",
      "min": 1,
      "why": "a version and steps are evidence even without a trace"
    },
    {
      "trap": "terse_feature_with_parity",
      "min": 1,
      "why": "parity with an existing feature defines done"
    },
    {
      "trap": "project_state_question",
      "min": 1,
      "why": "a question about the project is not code work"
    },
    {
      "trap": "reports_existing_behaviour_with_open_pr",
      "min": 1,
      "why": "existing behaviour reported as broken, already being fixed"
    },
    {
      "trap": "feature_with_open_pr",
      "min": 1,
      "why": "open work again, with a feature"
    },
    {
      "trap": "bug_with_evidence_control",
      "min": 1,
      "why": "a real bug with a debug trace"
    },
    {
      "trap": "feature_approved_by_maintainer",
      "min": 1,
      "why": "approval written by a maintainer is the intent signal that matters"
    },
    {
      "trap": "feature_approved_but_taken",
      "min": 1,
      "why": "approved and already being worked: the pre-gate must win"
    },
    {
      "trap": "feature_requested_as_a_question",
      "min": 1,
      "why": "a request phrased as a question is still a request"
    },
    {
      "trap": "question_that_reads_as_a_bug",
      "min": 1,
      "why": "a crash report that asks whether it is intended is a question"
    },
    {
      "trap": "documentation_error",
      "min": 1,
      "why": "wrong documentation is not code work"
    },
    {
      "trap": "non_code_community_resource",
      "min": 1,
      "why": "a request outside the codebase must be marked, not explored"
    },
    {
      "trap": "support_question_about_a_third_party",
      "min": 1,
      "why": "the failure is in another project"
    },
    {
      "trap": "behaviour_explained_as_by_design",
      "min": 1,
      "why": "existing behaviour reported as broken: P1 cannot settle intent"
    },
    {
      "trap": "bug_with_several_attempts",
      "min": 1,
      "why": "many attempts with no decision"
    },
    {
      "trap": "release_artifact_missing",
      "min": 1,
      "why": "the defect is in delivery, not in the source"
    },
    {
      "trap": "feature_by_analogy",
      "min": 1,
      "why": "a feature justified only by another tool"
    },
    {
      "trap": "feature_with_a_standard_citation",
      "min": 1,
      "why": "a standard cited as the specification"
    },
    {
      "trap": "proposal_with_design_discussion",
      "min": 1,
      "why": "discussion without a decision"
    },
    {
      "trap": "feature_forwarded_from_another_project",
      "min": 1,
      "why": "the request was moved here from elsewhere"
    },
    {
      "trap": "usage_question_answered",
      "min": 1,
      "why": "a question already answered: nothing to work"
    },
    {
      "trap": "capability_question",
      "min": 1,
      "why": "asking whether something is possible"
    },
    {
      "trap": "refused_in_prose_but_still_open",
      "min": 1,
      "why": "a refusal written by a maintainer on an issue that is still open: the only case the native layer cannot see"
    },
    {
      "trap": "soft_refusal_that_is_not_a_decision",
      "min": 1,
      "why": "a hedge is not a refusal"
    },
    {
      "trap": "feature_that_serves_everyone",
      "min": 1,
      "why": "alignment: a request that helps users other than the author"
    },
    {
      "trap": "feature_against_the_project_direction",
      "min": 1,
      "why": "alignment: a request that departs from what the project is"
    },
    {
      "trap": "closed_completed_merged_pr",
      "min": 20,
      "why": "a merged pull request closed it: the work really happened"
    },
    {
      "trap": "closed_refused_with_reason",
      "min": 14,
      "why": "a maintainer explained why it will not be done"
    },
    {
      "trap": "closed_refused_without_reason",
      "min": 20,
      "why": "closed as not planned with nothing in the text to read"
    },
    {
      "trap": "closed_completed_uncorroborated",
      "min": 20,
      "why": "closed as completed with no merged change: the label is weak, so this block measures ambiguity, not accuracy"
    }
  ],
  "required_provenance": {
    "real": 20,
    "synthetic": 8,
    "real-closed": 40
  },
